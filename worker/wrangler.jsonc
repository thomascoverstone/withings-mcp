{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "withings-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "WithingsMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WithingsMCP"] }],
  // Holds the Withings login. No id needed: the first deploy creates the namespace in your
  // Cloudflare account and later deploys keep using it.
  "kv_namespaces": [{ "binding": "TOKENS" }],
  "vars": {
    // Optional https origin of the worker for login links. Leave empty to use the origin each
    // request arrives on.
    "PUBLIC_URL": ""
  }
}
