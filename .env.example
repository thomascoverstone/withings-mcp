# Withings developer app credentials (developer.withings.com > your app).
# Copy .env.example to .env and paste the values here.
WITHINGS_CLIENT_ID=your-client-id
WITHINGS_CLIENT_SECRET=your-client-secret
# Must match the app's Callback URL character-for-character. Withings only accepts
# https URLs on port 443 (no localhost, no IP addresses), so the local login uses this
# pre-registered Withings endpoint and withings_auth.py reads the code from the address bar.
WITHINGS_REDIRECT_URI=https://wbsapi.withings.net/v2/oauth2
# OAuth scopes. user.metrics = body measurements + ECG; user.info = device list.
WITHINGS_SCOPE=user.metrics,user.info
