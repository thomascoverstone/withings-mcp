# Withings developer app credentials (developer.withings.com > your application).
# Copy this file to .env and fill in the two values; .env is git-ignored.
# Used by the remote server's setup (worker/scripts/setup.mjs) and by the local Python server.
WITHINGS_CLIENT_ID=your-client-id
WITHINGS_CLIENT_SECRET=your-client-secret

# Local Python server only.
# Must match a callback URL of your Withings app character for character. Withings only
# accepts https URLs on port 443 (no localhost, no IP addresses), so the local login uses
# this Withings endpoint and withings_auth.py reads the code from the browser's address bar.
WITHINGS_REDIRECT_URI=https://wbsapi.withings.net/v2/oauth2
# OAuth scopes: user.metrics = body measurements and ECG; user.info = device list.
WITHINGS_SCOPE=user.metrics,user.info
